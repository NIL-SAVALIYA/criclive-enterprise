# ==========================================================
# CRICLIVE ENTERPRISE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================================

# Server Configuration
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cricket_db?schema=public&connection_limit=20&pool_timeout=10"

# Authentication Security
JWT_SECRET="e9a8f7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8"
JWT_EXPIRES_IN="7d"

# CORS & Domain Security (Comma-separated origins)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://criclive.io"
CLIENT_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# File Upload Storage (Local / AWS S3)
STORAGE_PROVIDER="local" # Options: local, s3, cloudinary
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE_MB=5

# AWS S3 Configuration (Optional - Active if STORAGE_PROVIDER=s3)
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="criclive-media-assets"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
